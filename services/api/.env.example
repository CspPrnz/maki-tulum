NODE_ENV=development
APP_ENV=local
PORT=3001

# Use the docker-compose Postgres + Redis from infra/docker
DATABASE_URL=postgres://maki:maki@localhost:5432/maki
REDIS_URL=redis://localhost:6379

# Generate with: openssl genrsa -out jwt.pem 2048 && openssl rsa -in jwt.pem -pubout -out jwt.pub.pem
# Paste the contents (multi-line) below as base64 or use a secrets manager in real envs.
JWT_PRIVATE_KEY=replace-me-with-a-real-key-min-32-chars-long
JWT_PUBLIC_KEY=replace-me-with-a-real-key-min-32-chars-long

# Comma-separated. NEVER include localhost in production.
CORS_ORIGINS=http://localhost:3000

# Optional in dev. Absent SENTRY_DSN = observability is a no-op, not a crash.
SENTRY_DSN=
STRIPE_SECRET_KEY=
HOSTAWAY_CLIENT_ID=
HOSTAWAY_CLIENT_SECRET=
BREVO_API_KEY=
